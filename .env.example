# ==============================================================================
# VELURYN AGNECY & STUDIO ENVIRONMENT CONFIGURATION
# Set these in your local .env file or in Cloudflare Pages Dashboard -> Settings -> Environment Variables
# ==============================================================================

# Google Gemini API Key (Required for VELURYN Assistant AI Chat)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Optional, defaults to gemini-3-flash-preview)
GEMINI_MODEL=gemini-3-flash-preview

# Optional: Sentinel API Gateway Configuration (Private Rust Gateway)
# SENTINEL_GATEWAY_URL=https://sentinel.velurynagnecy.com/proxy
# SENTINEL_WEB_APP_TOKEN=your_sentinel_token_here

# Optional: Groq API Key (Fallback provider)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
